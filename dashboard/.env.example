# Dashboard data source: "api" (real backend) or "mock" (fully synthetic demo data)
VITE_API_MODE=api

# REST base. Dev server and nginx strip the /api prefix before proxying.
VITE_API_BASE_URL=/api

# WebSocket path. Not under /api.
VITE_WS_PATH=/ws/events

# REST polling interval in milliseconds (stats + timeseries).
VITE_REFRESH_MS=15000
