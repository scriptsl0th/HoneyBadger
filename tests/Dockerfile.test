# HoneyBadger test runner image
# Includes all dependencies needed to run attack scenario tests
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system dependencies for asyncssh, psycopg2, etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python test dependencies
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install -r backend/requirements.txt

COPY backend/requirements-dev.txt ./backend/requirements-dev.txt
RUN pip install -r backend/requirements-dev.txt

# Copy test files
COPY tests/ ./tests/
COPY backend/ ./backend/

# Set Python path
ENV PYTHONPATH=/app

# Default command runs all attack scenarios
CMD ["python3", "tests/attack_scenarios.py"]