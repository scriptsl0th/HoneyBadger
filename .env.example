# HoneyBadger environment template
# Copy to .env and adjust per environment.
# Every variable uses the HB_ prefix; values here match config.py defaults.

# --- Listen addresses & ports ---
# Addresses the honeypots + API bind to inside the backend container.
HB_SSH_HOST=0.0.0.0
HB_SSH_PORT=8022
HB_HTTP_HOST=0.0.0.0
HB_HTTP_PORT=8081
# Prometheus metrics exporter (backend :8000, container side).
HB_METRICS_PORT=8000
HB_API_HOST=0.0.0.0
HB_API_PORT=8090

# --- Database ---
# Async PostgreSQL connection, asyncpg driver only.
# Use host "postgres" when running under docker-compose; "localhost" for local runs.
HB_DATABASE_URL=postgresql+asyncpg://honeybadger:honeybadger@postgres:5432/honeybadger

# --- GeoIP enrichment ---
# Provider: "ip-api" (keyless, default) or "maxmind" (needs license key + DB below).
HB_GEOIP_PROVIDER=ip-api
# How many days to cache GeoIP lookups before re-querying.
HB_GEOIP_CACHE_TTL_DAYS=30
# MaxMind/GeoLite2 database path (only used when GEOIP_PROVIDER=maxmind).
# # Leave unset unless switching to maxmind; an empty value would parse as ".".
# HB_MAXMIND_DB_PATH=/data/GeoLite2-Country.mmdb
# MaxMind license key (only used when GEOIP_PROVIDER=maxmind). Keep it secret.
# HB_MAXMIND_LICENSE_KEY=YOUR_KEY

# --- Payload capture ---
# OFF by default: only payload metadata (URL, hash, size) is recorded.
# Set to true to stage payload files into a noexec quarantine dir for manual review.
HB_CAPTURE_PAYLOADS=false
# Directory where captured payload files are staged (never executed).
HB_QUARANTINE_DIR=/opt/hb-quarantine

# --- Demo / simulation ---
# True seeds the system with the bundled attack simulator (demos, integration tests).
HB_ENABLE_SIMULATOR=false

# --- Retention ---
# Single retention value: events older than this are purged (default 6 months).
HB_RETENTION_DAYS=180